    <recital>
      <conjunction>NOW THEREFORE BE IT RESOLVED,</conjunction>
      <text>that the Council hereby approves and authorizes the attached Budget Modification No. 2 to the FY 2025-2026 Annual Budget and that such modifications shall be effective immediately upon enactment; and,</text>
      <codify:insert path="6.3.34" codified:doc="Pueblo de San Ildefonso Code" codified:path="|6.3.34.020">
        <section>
          <num>6.3.34.020</num>
          <text>The Council hereby approves and authorizes the attached Budget Modification No. 2 to the FY 2025-2026 Annual Budget and that such modifications shall be effective immediately upon enactment.</text>
        </section>
      </codify:insert>
    </recital>
    <recital>
      <conjunction>BE IT FINALLY RESOLVED,</conjunction>
      <text>that the Pueblo de San Ildefonso Council hereby approves and adopts this resolution in accordance with the requirements of the Agreement, according to published Council procedures, and authorizes and directs the Governor, or his designee, to take such actions as deemed necessary to carry out the intent of this resolution.</text>
      <codify:insert path="6.3.34" codified:doc="Pueblo de San Ildefonso Code" codified:path="|6.3.34.030">
        <section>
          <num>6.3.34.030</num>
          <text>The Pueblo de San Ildefonso Council hereby approves and adopts this resolution in accordance with the requirements of the Agreement, according to published Council procedures, and authorizes and directs the Governor, or his designee, to take such actions as deemed necessary to carry out the intent of this resolution.</text>
